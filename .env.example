ENV=development
API_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://operator:operator@db:5432/operator_ai
REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-me-in-production
ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- AI provider: "openai" | "anthropic" | "none" ---
# "none" runs the app with deterministic heuristic fallbacks only (see
# ai/provider.py HeuristicOnlyProvider) - fine for local dev, not real AI.
#
# Default here is Groq (https://console.groq.com) - it speaks the OpenAI
# chat-completions API, so it works out of the box with the existing
# OpenAICompatibleProvider (no code change needed). Free tier: no credit
# card, ~14,400 requests/day, good open models (Llama 3.3 70B). Just sign
# up and paste your key into OPENAI_API_KEY below.
#
# Note: Groq has no embeddings endpoint, so semantic search in Knowledge
# will automatically fall back to keyword search (see ai/provider.py) -
# everything else (chat, tool calls, classification, briefings) works
# fully.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Google OAuth (login + Gmail/Calendar/Drive sync) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/callback

FRONTEND_URL=http://localhost:3000

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
